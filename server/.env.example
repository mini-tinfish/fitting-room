# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by Git: never commit real keys.

# Port for the Express server (the client expects 5000 by default).
PORT=5000

# Ask Darling (Gemini). Optional: without it, Ask Darling shows a setup message.
GEMINI_API_KEY=
# Optional: switch Gemini models without a code change.
# GEMINI_MODEL=

# Optional: extra browser origins allowed by CORS, comma-separated.
# The Railway frontend, https://outfit-darling.us and localhost are always allowed.
# CORS_ORIGINS=http://192.168.1.20:5173

# Background removal for closet uploads (https://www.remove.bg/dashboard#api-key).
# Optional: without it, uploads offer "Keep Original Photo" instead.
REMOVE_BG_API_KEY=
